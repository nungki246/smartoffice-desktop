    end
  end
  object FContent: TPanel
    Left = 0
    Top = 48
    Width = 964
    Height = 521
    Align = alClient
    BevelOuter = bvNone
    Color = clBtnFace
  end
  object FStatusBar: TStatusBar
    Left = 0
