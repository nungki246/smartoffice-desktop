      Font.Size = 13
      Font.Style = [fsBold]
      Layout = tlCenter
    end
    object FUserBadge: TLabel
      Left = 700
      Top = 5
      Width = 260
      Height = 38
      Align = alRight
      BorderSpacing.Right = 16
